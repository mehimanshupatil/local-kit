---
import ThemeToggle from './ThemeToggle';
import { categories } from '../../data/tools';
import Icon from '../ui/Icon';
import { List, CaretDown, Lock } from '@phosphor-icons/react';
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-[--background]/90 backdrop-blur-md border-b border-[--border-color]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-12 flex items-center justify-between gap-4">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 font-semibold text-sm text-[--foreground] hover:text-brand-500 transition-colors shrink-0 tracking-tight">
      <img src="/icon.svg" alt="LocalKit" class="size-6 rounded-sm" />
      <span class="hidden sm:block font-mono">LocalKit</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-0.5 flex-1 justify-center">
      {categories.map(cat => {
        const isActive = currentPath.startsWith(cat.href);
        return (
          <div class="relative group">
            <a
              href={cat.href}
              class:list={[
                'flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium transition-colors',
                isActive
                  ? 'text-brand-500 bg-brand-500/10'
                  : 'text-[--muted-foreground] hover:text-[--foreground] hover:bg-[--secondary]',
              ]}
            >
              <Icon icon={cat.icon} size={14} />
              {cat.title.replace(' Tools', '')}
              <CaretDown className="size-3 opacity-40 -mr-0.5" />
            </a>

            <!-- Dropdown -->
            <div class="absolute top-full left-0 mt-px w-48 bg-[--popover] border border-[--border-color] py-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-100 translate-y-0.5 group-hover:translate-y-0 shadow-xl shadow-black/30 z-50">
              {cat.tools.map(tool => (
                <a
                  href={tool.href}
                  class:list={[
                    'block px-3 py-1.5 text-xs transition-colors',
                    currentPath === tool.href
                      ? 'text-brand-500 bg-brand-500/10 font-medium'
                      : 'text-[--muted-foreground] hover:text-[--foreground] hover:bg-[--secondary]',
                  ]}
                >
                  {tool.name}
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </nav>

    <!-- Right side -->
    <div class="flex items-center gap-2 shrink-0">
      <span class="hidden lg:flex items-center gap-1.5 text-[10px] text-brand-500 bg-brand-500/10 px-2 py-1 font-mono font-medium border border-brand-500/20 tracking-wide">
        <Lock className="size-2.5" />
        LOCAL
      </span>

      <ThemeToggle client:load />

      <button
        id="mobile-menu-btn"
        aria-label="Open menu"
        class="md:hidden p-1.5 text-[--muted-foreground] hover:text-[--foreground] hover:bg-[--secondary] transition-colors"
      >
        <List className="size-4" />
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[--border-color] bg-[--background]">
    {categories.map(cat => (
      <div class="px-4 py-3 border-b border-[--border-color] last:border-0">
        <a href={cat.href} class="flex items-center gap-2 text-xs font-semibold text-[--foreground] uppercase tracking-wider mb-2">
          <Icon icon={cat.icon} size={14} />
          {cat.title}
        </a>
        <div class="grid grid-cols-2 gap-0.5 pl-1">
          {cat.tools.map(tool => (
            <a
              href={tool.href}
              class="text-xs text-[--muted-foreground] hover:text-brand-500 py-1 px-2 transition-colors"
            >
              {tool.name}
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>
