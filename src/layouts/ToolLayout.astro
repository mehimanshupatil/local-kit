---
import BaseLayout from "./BaseLayout.astro";
import type { Icon as PhosphorIcon } from "@phosphor-icons/react";

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  category: string;
  categoryHref: string;
  toolName: string;
  icon: PhosphorIcon;
  wide?: boolean;
}

const {
  title,
  description,
  canonicalURL,
  category,
  categoryHref,
  toolName,
  icon: ToolIcon,
  wide = false,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
  ogImage={canonicalURL
    ? `/og/${canonicalURL.replace(/^\//, "").replace(/\//g, "-")}.png`
    : undefined}
>
  <main class="min-h-screen pt-6 pb-16">
    <div
      class:list={[wide ? "max-w-6xl" : "max-w-3xl", "mx-auto px-4 sm:px-6"]}
    >
      <!-- Breadcrumb -->
      <nav
        class="flex items-center gap-2 text-xs text-muted-foreground mb-6 font-mono"
      >
        <a href="/" class="hover:text-brand-500 transition-colors">Home</a>
        <span class="opacity-40">/</span>
        <a
          href={categoryHref}
          class="hover:text-brand-500 transition-colors lowercase">{category}</a
        >
        <span class="opacity-40">/</span>
        <span class="text-foreground lowercase">{toolName}</span>
      </nav>

      <!-- Tool Header -->
      <div class="flex items-center gap-3 mb-8">
        <ToolIcon size={28} />
        <div>
          <h1 class="text-xl font-semibold text-foreground">{toolName}</h1>
          <p class="text-muted-foreground text-xs mt-0.5">{description}</p>
        </div>
      </div>

      <!-- Tool Content -->
      <slot />
    </div>
  </main>
</BaseLayout>
