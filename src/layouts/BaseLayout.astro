---
import "../styles/global.css";
import ToasterProvider from "../components/layout/ToasterProvider";
import PWAInstallPrompt from "../components/layout/PWAInstallPrompt";
import { pwaInfo } from "virtual:pwa-info";

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
}

const { title, description, canonicalURL } = Astro.props;
const siteURL = "https://localkit.app";
const fullTitle = title.includes("LocalKit") ? title : `${title} | LocalKit`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    {canonicalURL && <link rel="canonical" href={`${siteURL}${canonicalURL}`} />}

    <!-- OG -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalURL && <meta property="og:url" content={`${siteURL}${canonicalURL}`} />}

    <!-- Favicon & PWA -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon.svg" sizes="any" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />
    <meta name="theme-color" content="#10b981" />

    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}

    <!-- Theme: dark default, prevents flash -->
    <script is:inline>
      const stored = localStorage.getItem("theme");
      if (stored !== "light") {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body>
    <slot />
    <ToasterProvider client:load />
    <PWAInstallPrompt client:load />
  </body>
</html>
