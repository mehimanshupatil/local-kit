---
import "../styles/global.css";
import Sidebar from "../components/layout/Sidebar";
import ToasterProvider from "../components/layout/ToasterProvider";
import PWAInstallPrompt from "../components/layout/PWAInstallPrompt";
import { pwaInfo } from "virtual:pwa-info";

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string; // path like /og/pdf-merge.png — defaults to /og/home.png
}

const { title, description, canonicalURL, ogImage } = Astro.props;
const siteURL = "https://local-kit.himanshupatil.dev";
const fullTitle = title.includes("LocalKit") ? title : `${title} | LocalKit`;
const ogImageURL = `${siteURL}${ogImage ?? "/og/home.png"}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    {
      canonicalURL && (
        <link rel="canonical" href={`${siteURL}${canonicalURL}`} />
      )
    }

    <!-- OG -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {
      canonicalURL && (
        <meta property="og:url" content={`${siteURL}${canonicalURL}`} />
      )
    }
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon & PWA -->
    <link rel="icon" href="/favicon.svg" sizes="48x48" />
    <link rel="icon" href="/icon.svg" sizes="any" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />
    <meta name="theme-color" content="#10b981" />

    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}

    <!-- Theme: dark default, prevents flash -->
    <script is:inline>
      const stored = localStorage.getItem("theme");
      if (stored !== "light") {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body class="min-h-screen">
    <Sidebar client:load />

    <!-- Content offset: sidebar width on md+, top bar height on mobile -->
    <div class="md:pl-[220px] pt-12 md:pt-0">
      <slot />
    </div>

    <ToasterProvider client:load />
    <PWAInstallPrompt client:load />
  </body>
</html>
