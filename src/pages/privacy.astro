---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/layout/Footer.astro";
import { ShieldIcon } from "@phosphor-icons/react";
import { NOSTR_RELAYS, STUN_SERVERS } from "../lib/share/servers";
const lastUpdated = "November 2026";
const listServices = (services: { url: string; operator: string }[]) =>
  services.map((s) => `• ${s.url} (${s.operator})`).join("\n");
const data = [
  {
    title: "1. How LocalKit Works",
    body: `LocalKit is a client-side web application. Every tool — PDF manipulation, image processing, video conversion, and background removal — runs entirely inside your browser using WebAssembly (WASM), the Canvas API, and Web Workers.

When you drop a file into any tool, it is read into browser memory and processed locally. The output file is generated in your browser and downloaded directly to your device. No file data is ever transmitted to a server. The only exception to "files stay on your device" is the Share tools, which send a file straight to another device you choose — see section 6.`,
  },
  {
    title: "2. Files and Data",
    body: `We do not collect, transmit, store, or have any access to the files you process with LocalKit.

Files are loaded into your browser's memory (RAM) for processing and are cleared when you close the tab or navigate away. We have no server infrastructure that handles file data — there is no backend.`,
  },
  {
    title: "3. Analytics and Tracking",
    body: `LocalKit does not use advertising trackers, fingerprinting scripts, or behavioral analytics.

If analytics are ever added in the future, only privacy-respecting, cookieless analytics (such as page view counts) will be used, and this policy will be updated accordingly.`,
  },
  {
    title: "4. Cookies and Local Storage",
    body: `LocalKit uses localStorage to remember your dark/light theme preference, per-tool settings, and your recently used tools. No file content is ever stored. No tracking cookies are set. No third-party cookies are loaded.`,
  },
  {
    title: "5. Third-Party Services",
    body: `Fonts are self-hosted — no requests are made to Google Fonts or any font CDN. On first use, some tools download additional assets from a CDN: the Background Remover downloads an AI model (~50 MB), video/audio tools download the FFmpeg WebAssembly core (~30 MB), and the OCR tool downloads its engine assets (~10 MB). These requests reveal your IP address to those providers (standard for any web request) but no file content is involved.

No third-party advertising, analytics, or social media scripts are loaded.`,
  },
  {
    title: "6. Share Tools",
    body: `The Share tools (Send, Call) connect two of your devices directly to each other. Files, text, and call audio/video travel only over that direct connection, end-to-end encrypted. They never pass through a relay, a STUN server, or any server of ours, and nothing is stored.

To find each other and set up that connection, your devices use these public, third-party services:

Nostr relays — exchange encrypted connection-setup messages:
${listServices(NOSTR_RELAYS)}

STUN servers — tell your device its public IP address:
${listServices(STUN_SERVERS)}

These services can see your IP address, that a LocalKit device is looking for peers, and the encrypted setup messages. They never see file names, file contents, text, or call audio/video. No TURN relay is used: if your devices can't connect directly, the transfer fails rather than routing your data through a third party.

Share tools need an internet connection to pair devices. They are not loaded by any other tool, so the other tools never contact these services.`,
  },
  {
    title: "7. Offline Use",
    body: `After the initial page load, all tools except the Share tools work without an internet connection. The Background Remover model is cached in your browser after the first download and works offline on subsequent visits.`,
  },
  {
    title: "8. Open Source",
    body: `LocalKit is open source. You can audit the full source code on GitHub to verify these claims. There is no obfuscated code, no hidden network requests, and no server-side component.`,
  },
  {
    title: "9. Changes to This Policy",
    body: `If this policy changes, the updated version will be published at this URL with an updated date. We will not introduce data collection without clearly disclosing it here.`,
  },
  {
    title: "10. Contact",
    body: `Questions or concerns about privacy? Open an issue on GitHub.`,
  },
];
---

<BaseLayout
  title="Privacy Policy — LocalKit"
  description="LocalKit privacy policy. Your files never leave your device, or go straight to the device you choose. No uploads, no storage, no servers of ours."
  canonicalURL="/privacy"
>
  <main class="min-h-screen bg-gray-50 dark:bg-gray-950 py-16 px-4">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-10">
        <div class="text-5xl mb-4">🔒</div>
        <h1 class="text-4xl font-bold text-foreground mb-2">Privacy Policy</h1>
        <p class="text-sm text-muted-foreground">
          Last updated: {lastUpdated}
        </p>
      </div>

      <!-- TL;DR banner -->
      <div
        class="bg-brand-500/10/30 border border-brand-500/20 rounded-xl px-6 py-5 mb-10"
      >
        <p
          class="font-bold text-green-800 dark:text-green-300 mb-2 flex items-center gap-2"
        >
          <ShieldIcon className="size-5" />
          TL;DR — We collect nothing
        </p>
        <ul class="text-sm text-brand-500 space-y-1">
          <li>
            ✓ Your files are <strong>never uploaded</strong> to any server
          </li>
          <li>
            ✓ All processing happens <strong>locally in your browser</strong>
          </li>
          <li>✓ We collect <strong>no personal data</strong></li>
          <li>✓ We use <strong>no tracking cookies</strong></li>
          <li>
            ✓ Works <strong>fully offline</strong> after initial page load
            (except Share tools, which need a connection to pair)
          </li>
          <li>
            ✓ Share tools send files <strong>straight to your other device</strong>,
            never through a server
          </li>
        </ul>
      </div>

      <div
        class="bg-card rounded-xl border border-[--border-color] divide-y divide-gray-100 dark:divide-gray-800"
      >
        {
          data.map((section) => (
            <div class="px-6 py-6">
              <h2 class="font-semibold text-foreground mb-3">
                {section.title}
              </h2>
              <div class="text-sm text-muted-foreground leading-relaxed whitespace-pre-line">
                {section.body}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
