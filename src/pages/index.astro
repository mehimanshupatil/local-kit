---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/layout/Footer.astro";
import { categories } from "../data/tools";
import { Card } from "../components/ui/card";
import { ShieldIcon, LightningIcon, GlobeIcon } from "@phosphor-icons/react";
import RecentTools from "../components/shared/RecentTools";

const features = [
  {
    Icon: ShieldIcon,
    title: "Completely Private",
    desc: "All processing happens in your browser. Files never touch any server.",
  },
  {
    Icon: LightningIcon,
    title: "WASM Powered",
    desc: "FFmpeg, PDF.js, and native canvas APIs for fast, high-quality output.",
  },
  {
    Icon: GlobeIcon,
    title: "Works Offline",
    desc: "Once loaded, tools work without an internet connection.",
  },
];
---

<BaseLayout
  title="LocalKit — Free Privacy-First Browser Utilities"
  description="Free, privacy-first file tools that run 100% in your browser. PDF manipulation, image compression, video conversion and more — no uploads, no servers."
  canonicalURL="/"
  ogImage="/og/home.png"
>
  <main>
    <!-- Hero -->
    <section
      class="bg-linear-to-b from-background to-secondary pt-20 pb-16 px-4"
    >
      <div class="max-w-4xl mx-auto text-center">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-500/10 text-brand-500 text-sm font-medium mb-6"
        >
          🔒 100% Private — Files never leave your device
        </div>
        <h1
          class="text-5xl sm:text-6xl font-bold text-foreground mb-6 tracking-tight"
        >
          Powerful browser<br /><span class="text-brand-500">file tools</span>
        </h1>
        <p class="text-xl text-muted-foreground max-w-2xl mx-auto mb-10">
          PDF, image, and video tools powered by WebAssembly. Everything runs
          locally in your browser — no uploads, no servers, no privacy concerns.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          {
            categories.map((c) => {
              const CIcon = c.icon;
              return (
                <a
                  href={c.href}
                  class="inline-flex items-center gap-2 px-6 py-3 bg-brand-500 text-black font-medium text-base rounded-sm hover:bg-brand-400 transition-all duration-100"
                >
                  <CIcon size={18} /> {c.title}
                </a>
              );
            })
          }
        </div>
      </div>
    </section>

    <RecentTools client:load />

    <!-- Features -->
    <section class="py-12 px-4 bg-background border-y border-border">
      <div
        class="max-w-5xl mx-auto grid grid-cols-1 sm:grid-cols-3 gap-6 text-center"
      >
        {
          features.map(({ Icon, title, desc }) => (
            <div class="p-6">
              <div class="mb-3">
                <Icon size={36} className="m-auto" />
              </div>
              <h3 class="font-semibold text-foreground mb-2">{title}</h3>
              <p class="text-sm text-muted-foreground">{desc}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Tool Categories -->
    <section class="py-16 px-4">
      <div class="max-w-6xl mx-auto space-y-12">
        {
          categories.map((cat) => {
            const CatIcon = cat.icon;
            return (
              <div>
                <div class="flex items-center gap-3 mb-6">
                  <CatIcon size={28} />
                  <h2 class="text-2xl font-bold text-foreground">
                    {cat.title}
                  </h2>
                  <a
                    href={cat.href}
                    class="ml-auto text-sm text-brand-500 hover:underline"
                  >
                    View all →
                  </a>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
                  {cat.tools.map((tool) => {
                    const TIcon = tool.icon;
                    return (
                      <a href={tool.href} class="group block">
                        <Card
                          size="sm"
                          className="h-full p-4 flex flex-col gap-3 cursor-pointer transition-all duration-150 group-hover:ring-brand-500/40 group-hover:bg-secondary"
                        >
                          <TIcon
                            size={28}
                            className="group-hover:text-brand-500"
                          />
                          <span class="font-medium text-sm text-card-foreground group-hover:text-brand-500 transition-colors">
                            {tool.name}
                          </span>
                        </Card>
                      </a>
                    );
                  })}
                </div>
              </div>
            );
          })
        }
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
