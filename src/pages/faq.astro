---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/layout/Footer.astro";
import { CaretDownIcon, ShieldIcon } from "@phosphor-icons/react";
const faqs = [
  {
    q: "Are my files uploaded to any server?",
    a: "No. Every tool on LocalKit processes files entirely inside your browser using WebAssembly and the Canvas API. Your files are never sent over the network — not even to our servers. You can verify this by opening DevTools → Network and watching for zero outbound file traffic.",
  },
  {
    q: "Does it work offline?",
    a: "Yes — once the page has loaded, all tools work without an internet connection. The exceptions are tools that download assets on first use: Background Remover (~50 MB AI model), video/audio tools (~30 MB FFmpeg core), and OCR (~10 MB engine assets). Once a tool has been used once online, it's cached and works offline afterward.",
  },
  {
    q: "Is LocalKit free?",
    a: "Completely free, with no sign-up, no account, and no usage limits. There are no ads or paywalls.",
  },
  {
    q: "What browsers are supported?",
    a: "Any modern browser works: Chrome 92+, Firefox 79+, Safari 15.2+, and Edge 92+. Some tools (Background Remover, FFmpeg video tools) require SharedArrayBuffer support, which is available in all of the above.",
  },
  {
    q: "Is there a file size limit?",
    a: "There's no hard limit imposed by LocalKit — processing happens in your browser's memory, so the practical limit depends on your device's RAM. Large video files (>2 GB) may be slow or fail on low-memory devices. For most documents and images there is no noticeable limit.",
  },
  {
    q: "What file formats are supported?",
    a: "PDF tools support standard PDF files. Image tools support JPEG, PNG, WebP, AVIF, and GIF. Video tools support MP4, WebM, MOV, MKV, AVI, and most other common formats via FFmpeg WASM.",
  },
  {
    q: "How is this different from tools like Smallpdf, ILovePDF, or Canva?",
    a: "Those tools upload your files to their servers to process them. LocalKit never uploads anything — all computation happens locally. This means your sensitive documents (contracts, medical records, photos) stay on your device.",
  },
  {
    q: "What powers the tools under the hood?",
    a: "PDF tools use @cantoo/pdf-lib and PDF.js (Mozilla). Image tools use the browser Canvas API and browser-image-compression. Video tools use FFmpeg compiled to WebAssembly. Background Remover uses the @imgly/background-removal ONNX model. All run natively in your browser.",
  },
  {
    q: "Can I use LocalKit on mobile?",
    a: "Yes. All tools are responsive and work on iOS Safari and Android Chrome. Video processing on mobile can be slow for large files due to hardware constraints.",
  },
  {
    q: "Is the source code available?",
    a: "Yes — LocalKit is open source. You can inspect, fork, and self-host it.",
  },
];
---

<BaseLayout
  title="FAQ — LocalKit"
  description="Frequently asked questions about LocalKit — privacy, offline support, file limits, and how it works."
  canonicalURL="/faq"
>
  <main class="min-h-screen bg-gray-50 dark:bg-gray-950 py-16 px-4">
    <div class="max-w-3xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-foreground mb-3">
          Frequently Asked Questions
        </h1>
        <p class="text-muted-foreground">
          Everything you need to know about how LocalKit works.
        </p>
      </div>

      <!-- Privacy callout -->
      <div
        class="flex items-start gap-4 bg-brand-500/10/30 border border-brand-500/20 rounded-xl px-5 py-4 mb-10"
      >
        <ShieldIcon
          className="size-6 text-green-600 dark:text-green-400 shrink-0 mt-0.5"
        />

        <div>
          <p class="font-semibold text-green-800 dark:text-green-300 text-sm">
            Your files never leave your device
          </p>
          <p class="text-brand-500 text-sm mt-0.5">
            All processing happens locally using WebAssembly. No uploads. No
            servers. No accounts required.
          </p>
        </div>
      </div>

      <!-- FAQ list -->
      <div class="space-y-4">
        {
          faqs.map((faq, i) => (
            <details class="group bg-card rounded-xl border border-border overflow-hidden">
              <summary class="flex items-center justify-between gap-4 px-6 py-4 cursor-pointer list-none select-none hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
                <span class="font-medium text-foreground text-sm sm:text-base">
                  {faq.q}
                </span>

                <CaretDownIcon className="size-4 text-gray-400 shrink-0 transition-transform duration-200 group-open:rotate-180" />
              </summary>
              <div class="px-6 pb-5 pt-1 text-sm text-muted-foreground leading-relaxed border-t border-gray-100 dark:border-gray-800">
                {faq.a}
              </div>
            </details>
          ))
        }
      </div>

      <!-- Still have questions -->
      <div class="mt-12 text-center">
        <p class="text-sm text-muted-foreground">
          Still have questions?
          <a
            href="https://github.com/mehimanshupatil/local-kit/issues"
            class="text-brand-500 hover:underline ml-1"
            >Open an issue on GitHub →</a
          >
        </p>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
