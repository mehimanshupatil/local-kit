---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Footer from "../../components/layout/Footer.astro";
import { categories } from "../../data/tools";
import Icon from "../../components/ui/Icon";
import { Card } from "../../components/ui/card";

const cat = categories.find((c) => c.id === "video")!;
---

<BaseLayout
  ogImage="/og/video.png"
  title={cat.pageTitle}
  description={cat.pageDesc}
  canonicalURL={cat.href}
>
  <main class="min-h-screen bg-background py-12 px-4">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <div class="mb-4">
          <Icon icon={cat.icon} size={48} className="m-auto" />
        </div>
        <h1 class="text-4xl font-bold text-foreground mb-3">
          {cat.heading}
        </h1>
        <p class="text-muted-foreground max-w-xl mx-auto">
          {cat.subheading}
        </p>
        {
          cat.note && (
            <div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/10 text-amber-500 text-sm">
              {cat.note}
            </div>
          )
        }
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-5">
        {
          cat.tools.map((t) => (
            <a href={t.href} class="group block">
              <Card className="h-full p-4 flex flex-col gap-3 cursor-pointer transition-all duration-150 group-hover:ring-brand-500/40 group-hover:bg-secondary">
                <Icon icon={t.icon} size={28} />
                <div>
                  <p class="font-semibold text-card-foreground group-hover:text-brand-500 transition-colors">
                    {t.name}
                  </p>
                  <p class="text-sm text-muted-foreground mt-0.5">{t.desc}</p>
                </div>
              </Card>
            </a>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
